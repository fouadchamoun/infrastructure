{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":dependencyDashboard",
    ":configMigration",
    ":semanticPrefixFixDepsChoreOthers",
    ":ignoreModulesAndTests",
    ":separateMajorReleases",
    ":separatePatchReleases",
    ":pinVersions",
    "replacements:all",
    "workarounds:all",
    "abandonments:recommended",
    "helpers:pinGitHubActionDigests",
    "helpers:githubDigestChangelogs"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "7 days",
  "argocd": {
    "managerFilePatterns": [
      "k8s/bootstrap/*"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "k8s/**/*.yaml"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Talos & K8S versions based on renovate comments",
      "managerFilePatterns": [
        "k8s/talos/locals.tf",
        "k8s/bootstrap/tuppr/*"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>.*?)\\s*depName=(?<depName>.*?)(\\s*versioning=(?<versioning>.*?))?\\s*\\s*\\w+\\s*[:=]\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Update remote resource versions in the kubevirt kustomization.yaml from renovate comments",
      "managerFilePatterns": [
        "k8s/bootstrap/kubevirt/kustomization.yaml"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*-\\s+https?://[^\\s]+/(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)(?:/|\\s|$)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Apply 30-day minimum release age for Talos and Kubernetes updates and allow only next-minor.",
      "minimumReleaseAge": "30 days",
      "allowedVersions": "<={{major}}.{{add minor 1}}",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "siderolabs/talos",
        "kubernetes/kubernetes"
      ]
    },
    {
      "description": "Ignore minimum release age for non docker.io images in helm-values, helmv3 and argocd managers (no release date info)",
      "minimumReleaseAge": null,
      "matchManagers": [
        "helm-values",
        "helmv3",
        "argocd"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "!docker.io/**"
      ]
    },
    {
      "minimumReleaseAge": null,
      "matchDatasources": [
        "git-tags"
      ]
    },
    {
      "description": "Tag PRs that update Helm charts so the changelog workflow can run on them",
      "labels": [
        "needs-changelog-workflow"
      ],
      "matchManagers": [
        "helmv3",
        "argocd"
      ]
    },
    {
      "automerge": true,
      "labels": ["automerge"],
      "matchUpdateTypes": [
        "patch"
      ],
      "matchDepNames": [
        "!argo-cd"
      ],
      "matchManagers": [
        "helmv3",
        "helm-values",
        "argocd"
      ]
    },
    {
      "automerge": true,
      "labels": ["automerge"],
      "matchUpdateTypes": [
        "patch"
      ],
      "matchManagers": [
        "kubernetes"
      ],
      "matchDatasources": [
        "docker",
        "helm"
      ]
    },
    {
      "automerge": true,
      "labels": ["automerge"],
      "ignoreTests": true,
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "matchManagers": [
        "terraform"
      ]
    },
    {
      "matchManagers": [
        "helmv3"
      ],
      "matchPackageNames": [
        "oci.trueforge.org/truecharts/common"
      ],
      "sourceUrl": "https://github.com/trueforge-org/websites",
      "sourceDirectory": "truecharts/src/content/docs-common/"
    },
    {
      "matchManagers": [
        "helmv3"
      ],
      "matchPackageNames": [
        "oci.trueforge.org/truecharts/!(common)"
      ],
      "sourceUrl": "https://github.com/trueforge-org/websites",
      "sourceDirectory": "truecharts/src/content/docs/charts/stable/{{{depName}}}/"
    }
  ]
}
