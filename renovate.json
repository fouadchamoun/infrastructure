{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":dependencyDashboard",
    ":configMigration",
    ":semanticPrefixFixDepsChoreOthers",
    ":ignoreModulesAndTests",
    ":separateMajorReleases",
    ":separatePatchReleases",
    ":pinVersions",
    "replacements:all",
    "workarounds:all",
    "abandonments:recommended",
    "helpers:pinGitHubActionDigests",
    "helpers:githubDigestChangelogs"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "7 days",
  "argocd": {
    "managerFilePatterns": [
      "k8s/bootstrap/*"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "k8s/**/*.yaml"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update versions based on renovate comments in k8s/talos/locals.tf",
      "managerFilePatterns": [
        "k8s/talos/locals.tf"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>.*?)\\s*depName=(?<depName>.*?)(\\s*versioning=(?<versioning>.*?))?\\s*\\s*\\w+\\s*=\\s*\"?(?<currentValue>[^\"]+)\"?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Apply 30-day minimum release age for Talos and Kubernetes updates",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "siderolabs/talos",
        "kubernetes/kubernetes"
      ],
      "minimumReleaseAge": "30 days"
    },
    {
      "description": "Ignore minimum release age for quay/ghcr Docker images in helm-values and argocd managers (no release date info)",
      "matchManagers": [
        "helm-values",
        "argocd"
      ],
      "matchDatasources": [
        "docker"
      ],
      "minimumReleaseAge": null,
      "matchPackageNames": [
        "quay.io/{/,}**",
        "ghcr.io/{/,}**"
      ]
    },
    {
      "description": "Use regex versioning for homebridge Docker image date tags",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "homebridge/homebridge"
      ],
      "versioning": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$",
      "separateMajorMinor": false,
      "separateMinorPatch": false
    },
    {
      "matchDatasources": [
        "git-tags"
      ],
      "minimumReleaseAge": null
    },
    {
      "automerge": true,
      "matchUpdateTypes": [
        "patch"
      ],
      "matchDepNames": [
        "!argo-cd"
      ],
      "matchManagers": [
        "helmv3",
        "helm-values",
        "argocd",
      ]
    },
    {
      "automerge": true,
      "matchUpdateTypes": [
        "patch"
      ],
      "matchManagers": [
        "kubernetes"
      ],
      "matchDatasources": [
        "docker",
        "helm"
      ]
    },
    {
      "automerge": true,
      "matchUpdateTypes": [
        "patch",
        "minor",
      ],
      "matchManagers": [
        "terraform",
      ]
    }
  ]
}
