---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: longhorn # name is used to identify the volume /var/mnt/<name>
volumeType: disk
filesystem:
  type: xfs
provisioning:
  diskSelector:
    match: disk.size >= 1u * TB

---
apiVersion: v1alpha1
kind: VolumeConfig
name: EPHEMERAL
provisioning:
  maxSize: 30GB

---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: local-path-provisioner
provisioning:
  diskSelector:
    match: disk.size <= 500u * GB
  minSize: 10GB
  grow: true
