---
apiVersion: v1alpha1
kind: HostnameConfig
auto: "off"
hostname: ${hostname}

---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: sfp%d
selector:
  match: link.driver == "i40e"
---
apiVersion: v1alpha1
kind: BondConfig
name: bond0
links:
  - sfp0
  - sfp1
bondMode: 802.3ad
lacpRate: slow
miimon: 100
updelay: 200
downdelay: 200
xmitHashPolicy: layer2
---
apiVersion: v1alpha1
kind: BridgeConfig
name: br0
links:
  - bond0
stp:
  enabled: false
addresses:
  - address: ${ip_cidr}
routes:
  - gateway: ${ip_gateway}
---
apiVersion: v1alpha1
kind: Layer2VIPConfig
link: br0 # Name of the link to assign the VIP to.
name: ${ip_vip} # IP address to be advertised as a Layer 2 VIP.
